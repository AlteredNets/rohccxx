#ifndef ROHCCXX_VERSION_H
#define ROHCCXX_VERSION_H

#define ROHCCXX_VERSION_STRING "@PROJECT_VERSION@"
#define ROHCCXX_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ROHCCXX_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ROHCCXX_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define ROHCCXX_VERSION_ENCODED ((ROHCCXX_VERSION_MAJOR * 1000000) + (ROHCCXX_VERSION_MINOR * 1000) + ROHCCXX_VERSION_PATCH)

#endif /* ROHCCXX_VERSION_H */
